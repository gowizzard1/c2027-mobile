{
  "expo": {
    "name": "IKM Campaign Team",
    "slug": "ikm-campaign-team",
    "scheme": "maiywa-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow campaign team members to select an official counted-results form for private submission.",
        "NSCameraUsageDescription": "Allow campaign team members to photograph an official counted-results form for private submission.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.maiywax91.ikmcampaignteam"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.maiywax91.ikmcampaignteam"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow campaign team members to select official counted-results form images.",
          "cameraPermission": "Allow campaign team members to photograph official counted-results forms."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "850d4923-e6fd-4fee-9057-376e044ff319"
      }
    }
  }
}
